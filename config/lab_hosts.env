# XTraffic laboratory host configuration.
# This file is intentionally tracked as the single source of shared lab defaults.

# Local 5080 workstation.
LAB_5080_USER=${LAB_5080_USER:-asus}
LAB_5080_HOST=${LAB_5080_HOST:-192.168.31.93}
LAB_5080_PASSWORD=${LAB_5080_PASSWORD:-Hzj050916}
LAB_5080_TAILSCALE_HOST=${LAB_5080_TAILSCALE_HOST:-100.126.189.30}
LAB_5080_SSH=${LAB_5080_SSH:-${LAB_5080_USER}@${LAB_5080_HOST}}
LAB_5080_TAILSCALE_SSH=${LAB_5080_TAILSCALE_SSH:-${LAB_5080_USER}@${LAB_5080_TAILSCALE_HOST}}

# Passwordless result relay.
LAB_RELAY_USER=${LAB_RELAY_USER:-root}
LAB_RELAY_HOST=${LAB_RELAY_HOST:-8.134.12.5}
LAB_RELAY_SSH=${LAB_RELAY_SSH:-${LAB_RELAY_USER}@${LAB_RELAY_HOST}}
LAB_RELAY_DIR=${LAB_RELAY_DIR:-/root/xtraffic_results}
LAB_RELAY_AUTH=${LAB_RELAY_AUTH:-passwordless}

